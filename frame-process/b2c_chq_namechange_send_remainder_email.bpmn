    <bpmn:serviceTask id="Activity_SendRemainderEmail" name="Send Remainder Email" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="4" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="=calvinSessionId" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=technicalEmailURL" target="url" />
          <zeebe:input source="={&#10;  &#34;feId&#34;: feid,&#10;  &#34;language&#34;: &#34;DE&#34;,&#10;  &#34;traceId&#34;: traceId,&#10;  &#34;x-source-service&#34;: &#34;Camunda Namechange&#34;&#10;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="// TO DO: Add payload" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="remainderEmailResponse" />
          <zeebe:header key="errorExpression" value="=if error.code != null then&#10;  if (matches(error.code, &#34;^4[0-9]{2}$&#34;) or job.retries &#60;= 1) then&#10;    bpmnError(&#10;      &#34;SEND_REMAINDER_EMAIL_REST_API_ERROR&#34;,&#10;      &#34;Error thrown while calling the Send Technical Email REST API&#34;,&#10;      {&#10;        fullErrorObject: error,&#10;        errorCode: error.code,&#10;        errorResponse: error.variables.response.body&#10;      })&#10;  else &#10;    jobError(&#10;      error.message,&#10;      {},&#10;      job.retries - 1,&#10;      duration(&#34;PT5S&#34;)&#10;    )&#10;else&#10;  null" />
          <zeebe:header key="retryBackoff" value="PT5S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07et4ni</bpmn:incoming>
      <bpmn:outgoing>Flow_1libf8f</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1libf8f" sourceRef="Activity_SendRemainderEmail" targetRef="Activity_CalvinSessionLogout" />
  </bpmn:process>
